<!DOCTYPE template>
<!-- Nocturne: mixer. One EQ band: knob, caption, kill dot (the dot is only shown while the
  [Nocturne],show_eq_kill_buttons setting is on). Variables: EqFxUnit, EqEffect, EqParameter, EqRange (High|Mid|Low), Label -->
<Template>
  <WidgetGroup>
    <ObjectName>NocturneMixCell</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>52f,31f</Size>
        <Children>
          <WidgetGroup><Size>8me,0min</Size></WidgetGroup>
          <EffectParameterKnobComposed>
            <TooltipId>filter<Variable name="EqRange"/></TooltipId>
            <Size>36f,31f</Size>
            <Knob>skins:Nocturne/<Variable name="KnobScheme"/>/knobs/knob_indicator_regular_<Variable name="KnobColorEq"/>.svg</Knob>
            <BackPath>skins:Nocturne/<Variable name="KnobScheme"/>/knobs/knob_bg_regular.svg</BackPath>
            <MinAngle><Variable name="PotiMinAngle"/></MinAngle>
            <MaxAngle><Variable name="PotiMaxAngle"/></MaxAngle>
            <ArcRadius><Variable name="ArcRadiusBig"/></ArcRadius>
            <ArcThickness><Variable name="ArcThicknessBig"/></ArcThickness>
            <ArcColor><Variable name="ArcColorEq"/></ArcColor>
            <ArcRoundCaps><Variable name="ArcRoundCaps"/></ArcRoundCaps>
            <KnobCenterYOffset>1.998</KnobCenterYOffset>
            <EffectUnitGroup><Variable name="EqFxUnit"/></EffectUnitGroup>
            <Effect>1</Effect>
            <EffectParameter><Variable name="EqParameter"/></EffectParameter>
            <Connection>
              <ConfigKey><Variable name="EqEffect"/>,parameter<Variable name="EqParameter"/></ConfigKey>
            </Connection>
          </EffectParameterKnobComposed>
          <WidgetGroup><Size>8me,0min</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Size>52f,12f</Size>
        <Children>
          <WidgetGroup><Size>9f,0min</Size></WidgetGroup>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
          <Label>
            <ObjectName>NocturneMixLabel</ObjectName>
            <SizePolicy>min,f</SizePolicy>
            <Text><Variable name="Label"/></Text>
            <Alignment>center</Alignment>
          </Label>
          <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>9f,9f</Size>
            <Children>
              <PushButton>
                <TooltipId>filter<Variable name="EqRange"/>Kill</TooltipId>
                <ObjectName>NocturneDot</ObjectName>
                <Size>9f,9f</Size>
                <NumberStates>2</NumberStates>
                <RightClickIsPushButton>false</RightClickIsPushButton>
                <State><Number>0</Number></State>
                <State><Number>1</Number></State>
                <Connection>
                  <ConfigKey><Variable name="EqEffect"/>,button_parameter<Variable name="EqParameter"/></ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey persist="true">[Nocturne],show_eq_kill_buttons</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey><Variable name="EqEffect"/>,parameter<Variable name="EqParameter"/>_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
