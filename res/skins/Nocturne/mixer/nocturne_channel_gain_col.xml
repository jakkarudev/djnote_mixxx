<!DOCTYPE template>
<!-- Nocturne: mixer. Outer column of a channel: GAIN (+clip light), FLTR, FX 1/2, KEY. Variable: ChanNum -->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <SetVariable name="QuickGroup">[QuickEffectRack1_[Channel<Variable name="ChanNum"/>]]</SetVariable>
  <WidgetGroup>
    <ObjectName>NocturneMixCol</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>min,min</SizePolicy>
    <Children>

      <WidgetGroup><Size>0min,3f</Size></WidgetGroup>

      <!-- GAIN + clip light -->
      <WidgetGroup>
        <ObjectName>NocturneMixCell</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>52f,31f</Size>
            <Children>
              <WidgetGroup><Size>8me,0min</Size></WidgetGroup>
              <Template src="skins:Nocturne/controls/knob.xml">
                <SetVariable name="Size">36f,31f</SetVariable>
                <SetVariable name="KnobColor">grey</SetVariable>
                <SetVariable name="KnobBg">regular</SetVariable>
                <SetVariable name="KnobIndicator">regular</SetVariable>
                <SetVariable name="ArcRadius"><Variable name="ArcRadiusBig"/></SetVariable>
                <SetVariable name="ArcThickness"><Variable name="ArcThicknessBig"/></SetVariable>
                <SetVariable name="ArcColor"><Variable name="ArcColorGain"/></SetVariable>
                <SetVariable name="Control">pregain</SetVariable>
                <SetVariable name="TooltipId">pregain</SetVariable>
              </Template>
              <WidgetGroup><Size>8me,0min</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>52f,12f</Size>
            <Children>
              <WidgetGroup><Size>9f,0min</Size></WidgetGroup>
              <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
              <Label>
                <ObjectName>NocturneMixLabel</ObjectName>
                <SizePolicy>min,f</SizePolicy>
                <Text>GAIN</Text>
                <Alignment>center</Alignment>
              </Label>
              <WidgetGroup><Size>0me,0min</Size></WidgetGroup>
              <WidgetGroup>
                <ObjectName>NocturneClipLight</ObjectName>
                <TooltipId>channel_peak_indicator</TooltipId>
                <Size>9f,9f</Size>
                <Connection>
                  <ConfigKey><Variable name="Group"/>,peak_indicator</ConfigKey>
                  <BindProperty>highlight</BindProperty>
                </Connection>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0min,3f</Size></WidgetGroup>

      <!-- FLTR (quick effect), part of the EQ knob setting -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Template src="skins:Nocturne/mixer/nocturne_mix_knob.xml">
            <SetVariable name="Group"><Variable name="QuickGroup"/></SetVariable>
            <SetVariable name="Control">super1</SetVariable>
            <SetVariable name="TooltipId">QuickEffectRack_super1</SetVariable>
            <SetVariable name="Label">FLTR</SetVariable>
            <SetVariable name="DotGroup"><Variable name="QuickGroup"/></SetVariable>
            <SetVariable name="DotControl">enabled</SetVariable>
            <SetVariable name="DotTooltipId">QuickEffectRack_enabled</SetVariable>
            <SetVariable name="DotVisKey">[Nocturne],show_eq_kill_buttons</SetVariable>
          </Template>
          <WidgetGroup><Size>0min,3f</Size></WidgetGroup>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Nocturne],show_eq_knobs</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <!-- FX 1 / FX 2 -->
      <WidgetGroup>
        <ObjectName>NocturneMixCell</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>52f,18f</Size>
            <Children>
              <WidgetGroup><Size>2me,0min</Size></WidgetGroup>
              <Template src="skins:Nocturne/controls/button_flat_text.xml">
                <SetVariable name="ObjectName">NocturneBtn</SetVariable>
                <SetVariable name="TooltipId">EffectUnit_deck_enabled</SetVariable>
                <SetVariable name="Size">21f,18f</SetVariable>
                <SetVariable name="Text">1</SetVariable>
                <SetVariable name="ConfigKey">[EffectRack1_EffectUnit1],group_<Variable name="Group"/>_enable</SetVariable>
              </Template>
              <WidgetGroup><Size>1f,0min</Size></WidgetGroup>
              <Template src="skins:Nocturne/controls/button_flat_text.xml">
                <SetVariable name="ObjectName">NocturneBtn</SetVariable>
                <SetVariable name="TooltipId">EffectUnit_deck_enabled</SetVariable>
                <SetVariable name="Size">21f,18f</SetVariable>
                <SetVariable name="Text">2</SetVariable>
                <SetVariable name="ConfigKey">[EffectRack1_EffectUnit2],group_<Variable name="Group"/>_enable</SetVariable>
              </Template>
              <WidgetGroup><Size>2me,0min</Size></WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <Layout>horizontal</Layout>
            <Size>52f,14f</Size>
            <Children>
              <Label>
                <ObjectName>NocturneMixLabelFx</ObjectName>
                <SizePolicy>me,f</SizePolicy>
                <Text>FX</Text>
                <Alignment>center</Alignment>
              </Label>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0min,3f</Size></WidgetGroup>

      <!-- KEY (key shift), gated by the Key Controls setting. The key lock dot is kept hidden:
           the deck's key lock button already does that. -->
      <WidgetGroup>
        <Layout>vertical</Layout>
        <SizePolicy>min,min</SizePolicy>
        <Children>
          <Template src="skins:Nocturne/mixer/nocturne_mix_knob.xml">
            <SetVariable name="Control">pitch_adjust</SetVariable>
            <SetVariable name="TooltipId">pitch_adjust</SetVariable>
            <SetVariable name="Label">KEY</SetVariable>
            <SetVariable name="DotGroup"><Variable name="Group"/></SetVariable>
            <SetVariable name="DotControl">keylock</SetVariable>
            <SetVariable name="DotTooltipId">keylock</SetVariable>
            <SetVariable name="DotVisKey">[Nocturne],show_key_lock_dot</SetVariable>
          </Template>
        </Children>
        <Connection>
          <ConfigKey persist="true">[Nocturne],show_key_controls</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <WidgetGroup><Size>0min,0me</Size></WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
