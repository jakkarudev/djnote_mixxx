<!-- Nocturne loop size cell. Variables: Group, Size (e.g. 0.25), Text -->
<Template>
  <Template src="skins:Nocturne/controls/nocturne_btn_disp.xml">
    <SetVariable name="TooltipId">beatloop_size</SetVariable>
    <SetVariable name="ObjectName">NocturneBtnCell</SetVariable>
    <SetVariable name="Size">24me,26f</SetVariable>
    <SetVariable name="ConfigKey"><Variable name="Group"/>,beatloop_<Variable name="LoopSize"/>_toggle</SetVariable>
    <SetVariable name="ConfigKeyDisp"><Variable name="Group"/>,beatloop_<Variable name="LoopSize"/>_enabled</SetVariable>
  </Template>
</Template>
