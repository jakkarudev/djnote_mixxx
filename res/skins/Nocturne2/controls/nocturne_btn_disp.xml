<!--
Description:
  Nocturne flat text button whose lit state follows a different control than the one it clicks
  (e.g. loop size 4 clicks beatloop_4_toggle and lights from beatloop_4_enabled).
Variables:
  ObjectName, TooltipId, Size, Text, ConfigKey (clicked), ConfigKeyDisp (displayed)
-->
<Template>
  <PushButton>
    <TooltipId><Variable name="TooltipId"/></TooltipId>
    <ObjectName><Variable name="ObjectName"/></ObjectName>
    <Size><Variable name="Size"/></Size>
    <NumberStates>2</NumberStates>
    <RightClickIsPushButton>false</RightClickIsPushButton>
    <State>
      <Number>0</Number>
      <Text><Variable name="Text"/></Text>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="Text"/></Text>
    </State>
    <Connection>
      <ConfigKey><Variable name="ConfigKey"/></ConfigKey>
      <ButtonState>LeftButton</ButtonState>
    </Connection>
    <Connection>
      <ConfigKey><Variable name="ConfigKeyDisp"/></ConfigKey>
      <ConnectValueFromWidget>false</ConnectValueFromWidget>
    </Connection>
  </PushButton>
</Template>
